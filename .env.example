# .env.example — COPIAR a .env (nunca commitear). En Vercel: Project → Settings → Environment Variables.
# El frontend estático NO requiere variables. Estas son para la API y analítica futura.

# --- API (api/) — Production / Preview / Development ---
# DATABASE_URL=postgresql://user:pass@host:5432/inventa
# SUPABASE_URL=https://xyz.supabase.co
# SUPABASE_SERVICE_KEY=
# JWT_SECRET=generar-con-openssl-rand-hex-32
# OPENAI_API_KEY=
# GOOGLE_GEMINI_KEY=
# ANTHROPIC_API_KEY=
# WHATSAPP_TOKEN=
# ALLOWED_ORIGINS=https://inventa.ai,https://www.inventa.ai

# --- Analítica (inyectar IDs al activar) ---
# GA_MEASUREMENT_ID=G-XXXXXXX
# CLARITY_PROJECT_ID=
