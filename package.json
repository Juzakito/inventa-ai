{
  "name": "inventa-ai",
  "version": "1.4.0",
  "private": true,
  "description": "INVENTA.AI — El Cerebro de Compras para tu Empresa",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.js && node scripts/validate-build.js",
    "lint": "npx htmlhint public/index.html && node scripts/check-modules.js",
    "test": "node tests/engine-check.js && node tests/audit-ids.js && python ai-engine/test_smoke.py",
    "serve": "python -m http.server 5173 --directory public",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "htmlhint": "^1.1.4"
  },
  "engines": { "node": ">=20" }
}
